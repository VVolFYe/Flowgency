# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.venv/
venv/
env/

# Node / Next.js
node_modules/
.next/
out/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts
.npm/
.yarn/
.pnpm-store/

# Environment and secrets (examples are safe to track)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Vision datasets, weights, and large downloaded media
datasets/
# Source code, not a dataset: AI Traffic dataset-selection API routes.
!/frontend/app/api/operator/ai-traffic/datasets/
data/raw/
# default vision data folder (clips, weights, caches, full outputs) when UNIHACK_DIR is not set
/data/
# local analytics database (derived from frontend/public/analytics/, see backend/analytics/load.py)
data/*.sqlite3
data/*.sqlite3-journal
weights/
models/*.pt
models/*.pth
models/*.onnx
models/*.engine
*.mp4
*.avi
*.mov
*.mkv
*.webm

# Generated SUMO/runtime output (scenario definitions remain tracked)
scenarios/**/output/
scenarios/**/outputs/
simulation_output/
sumo_output/
*.tripinfo.xml
*.fcd.xml
*.emission.xml
*.queue.xml
*.summary.xml
*.vehroute.xml
*.tls-state.xml
*.trace.xml
*.sumo.log
scenarios/**/route_errors.log
metrics.generated.json

# Temporary files
*.tmp
*.temp
*.bak

# Vision runtime artefacts (all generated output belongs in $UNIHACK_DIR, outside the repo)
*.pt
*.pth
*.onnx
runs/
vision_output/
# gate mode: detection caches and full-run logs (samples under backend/vision/samples/ stay tracked)
*.npz
gate_run.json
ultralytics_config/
backend/vision/config/*.jpg
backend/vision/config/*.png

# AI Traffic replay assets. Everything stays ignored (raw inputs such as
# assets/ai-traffic/inputs/, legacy single-bundle outputs, run directories, tmp)
# except the finished files of each validated bundle under versions/<bundle>/.
# Bundle videos are Git LFS objects (see .gitattributes).
/assets/ai-traffic/*
!/assets/ai-traffic/versions/
/assets/ai-traffic/versions/*/*
!/assets/ai-traffic/versions/*/replay_manifest.json
!/assets/ai-traffic/versions/*/replays/
!/assets/ai-traffic/versions/*/reports/
/assets/ai-traffic/versions/*/reports/*
!/assets/ai-traffic/versions/*/reports/comparison_report.json
!/assets/ai-traffic/versions/*/videos/
!/assets/ai-traffic/versions/*/videos/*.mp4
