NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000

# Auth0 Next.js SDK v4 (Regular Web Application)
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_SECRET=generate-with-openssl-rand-hex-32
APP_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=https://api.flowgency.local
AUTH0_ANALYST_CONNECTION=email
AUTH0_OPERATOR_CONNECTION=Username-Password-Authentication

# ElevenLabs credentials belong to the backend process only. Never add an
# ELEVENLABS_API_KEY or any other secret with a NEXT_PUBLIC_ prefix here.
