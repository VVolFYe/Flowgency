<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="https://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="../london.net.xml"/>
        <route-files value="../demand/rush_hour.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="2400"/>
        <step-length value="1"/>
    </time>
    <random_number><seed value="20261113"/></random_number>
    <output>
        <tripinfo-output value="../output/rush_hour/tripinfo.xml"/>
        <tripinfo-output.write-unfinished value="true"/>
        <summary-output value="../output/rush_hour/summary.xml"/>
        <summary-output.period value="10"/>
    </output>
    <processing>
        <collision.action value="warn"/>
        <collision.check-junctions value="true"/>
    </processing>
    <report><verbose value="true"/><no-step-log value="true"/></report>
</configuration>
