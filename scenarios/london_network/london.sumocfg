<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="https://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="london.net.xml"/>
        <route-files value="london.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="1200"/>
        <step-length value="1"/>
    </time>
    <random_number>
        <seed value="42"/>
    </random_number>
    <output>
        <tripinfo-output value="output/london.tripinfo.xml"/>
        <tripinfo-output.write-unfinished value="true"/>
        <summary-output value="output/london.summary.xml"/>
        <summary-output.period value="10"/>
    </output>
    <processing>
        <collision.action value="warn"/>
    </processing>
    <report>
        <verbose value="true"/>
        <no-step-log value="true"/>
    </report>
</configuration>
