# The same tenant domain and API identifier used by the frontend.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.flowgency.local

# Analytics database. Unset = local SQLite at data/analytics.sqlite3.
# For the team's shared Postgres, set the URL here in single quotes (get it privately; never commit it):
# FLOWGENCY_ANALYTICS_DB='postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require'
