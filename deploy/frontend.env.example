# Store as ~/flowgency/shared/frontend.env on the VM; chmod 600.
# Both public URLs must use the same real HTTPS hostname (no trailing slash).
NEXT_PUBLIC_BACKEND_URL=https://flowgency.example.com
BACKEND_URL=http://127.0.0.1:8000
APP_BASE_URL=https://flowgency.example.com
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=replace-me
AUTH0_CLIENT_SECRET=replace-me
AUTH0_SECRET=replace-with-openssl-rand-hex-32
AUTH0_AUDIENCE=https://api.flowgency.local
AUTH0_ANALYST_CONNECTION=email
AUTH0_OPERATOR_CONNECTION=Username-Password-Authentication
