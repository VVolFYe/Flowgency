[Unit]
Description=Flowgency API and shared SUMO worker

[Service]
Type=simple
WorkingDirectory=%h/flowgency/current
ExecStart=/bin/bash %h/flowgency/current/deploy/start-backend.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
