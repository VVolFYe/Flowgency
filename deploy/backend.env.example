# Store as ~/flowgency/shared/backend.env on the VM; chmod 600.
# Shell-compatible assignments: quote values, especially those with spaces/$/#.
AUTH0_DOMAIN='your-tenant.eu.auth0.com'
AUTH0_AUDIENCE='https://api.flowgency.local'
ELEVENLABS_API_KEY='replace-me'
ELEVENLABS_VOICE_ID='replace-me'
FLOWGENCY_VOICE_LANGUAGE='en'
# Optional AI analytics review; leave unset if not using Gemini.
# GEMINI_API_KEY='replace-me'
# GEMINI_MODEL='gemini-3.5-flash'
# Unset = persistent SQLite at ~/flowgency/shared/analytics.sqlite3.
# FLOWGENCY_ANALYTICS_DB='postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require'
